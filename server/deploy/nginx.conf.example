# Reverse proxy for docker-compose.prod.yaml. Replace mem.example.com, install as
# /etc/nginx/sites-available/mem0, then run `certbot --nginx -d mem.example.com`
# (certbot adds the TLS listener and the HTTP->HTTPS redirect).
#
#   /            -> dashboard      127.0.0.1:3000
#   /api/v1/     -> REST API       127.0.0.1:8888  (prefix stripped; MEM0_ROOT_PATH=/api/v1)
#   /mcp + OAuth -> MCP server     127.0.0.1:8765

# Brute-force and registration-spam protection for the OAuth endpoints.
limit_req_zone $binary_remote_addr zone=mem0_oauth:1m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name mem.example.com;

    client_max_body_size 10m;

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8888/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # MCP endpoint. The URL may contain MCP_URL_SECRET; keep it out of logs.
    location /mcp {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
        access_log off;
    }

    # OAuth 2.1 for MCP: discovery metadata, endpoints, login page.
    # Without these, the dashboard answers discovery probes with its login page
    # and MCP clients fail to connect.
    location ~ ^/(\.well-known/oauth-(protected-resource|authorization-server)|authorize$|token$|register$|revoke$|oauth/) {
        limit_req zone=mem0_oauth burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Clients that fall back to the root form of RFC 9728 discovery.
    location = /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:8765/.well-known/oauth-protected-resource/mcp;
    }
    location = /.well-known/openid-configuration {
        default_type application/json;
        return 404 '{"error":"not_found"}';
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
