# LLM (DeepSeek) and embedder (Voyage AI) keys.
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=

# HTTP proxy used ONLY for Voyage AI requests, e.g. when Voyage blocks the
# server's IP. Format: http://user:password@host:port. Leave empty to connect
# directly. DeepSeek and everything else always connect directly.
VOYAGE_PROXY_URL=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=deepseek-flash
MEM0_DEFAULT_EMBEDDER_MODEL=voyage-4
# Embedding vector size. Changing it after memories exist requires re-creating the pgvector table.
MEM0_EMBEDDING_DIMS=1024

# Production stack (docker-compose.prod.yaml) behind a reverse proxy.
# PUBLIC_API_URL is what the dashboard's browser code calls; MEM0_ROOT_PATH is
# the path prefix the proxy strips before forwarding to the API.
PUBLIC_API_URL=https://mem.example.com/api/v1
MEM0_ROOT_PATH=/api/v1

# MCP server (server/mcp). Set at least one; generate with `openssl rand -hex 32`.
#   MCP_AUTH_TOKEN - clients send `Authorization: Bearer <token>` to /mcp
#   MCP_URL_SECRET - header-less clients (web connectors) connect to /mcp/<secret>
MCP_AUTH_TOKEN=
MCP_URL_SECRET=
# All MCP clients read and write memories under this user_id.
MCP_DEFAULT_USER_ID=default

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=false

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
